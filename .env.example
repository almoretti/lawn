# Copy to .env.local and fill in. `bun run dev` provisions a local Convex
# deployment and seeds the secrets below into it (scripts/convex-local-setup.sh).
# Values marked "auto" are written/rewritten by `convex dev` — leave them blank.

# convex
CONVEX_DEPLOYMENT=                  # auto
VITE_CONVEX_URL=                    # auto
VITE_CONVEX_SITE_URL=              # auto

# auth
# AUTH_MODE=dev       local dev — mints a JWT for a fixed identity, no IdP.
# AUTH_MODE=gateway   production default — trusts the SSO gateway's email
#                     header (x-forwarded-email et al.) and mints a JWT from
#                     it. Set DEV_AUTH_ISSUER to the app's own URL and
#                     AUTH_JWT_PRIVATE_KEY (PEM) so the signing key is stable.
# AUTH_MODE=cloudflare behind Cloudflare Access — passes through the edge JWT;
#                     set CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD on Convex.
AUTH_MODE=dev
#AUTH_JWT_PRIVATE_KEY=
DEV_AUTH_ISSUER=http://127.0.0.1:5296
DEV_AUTH_USER_ID=local-dev-user
DEV_AUTH_NAME=Local Dev
DEV_AUTH_EMAIL=dev@localhost
# Referenced by convex/auth.config.ts — must exist on the deployment even when
# unused (Convex requires it); empty disables the provider.
CLERK_JWT_ISSUER_DOMAIN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC_MONTHLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx

# mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=                    # PEM; \n escapes are normalized

# storage (s3)
RAILWAY_ENDPOINT=
RAILWAY_ACCESS_KEY_ID=
RAILWAY_SECRET_ACCESS_KEY=
RAILWAY_REGION=us-east-1            # optional, default us-east-1
RAILWAY_BUCKET_NAME=videos         # optional, default videos
RAILWAY_PUBLIC_URL=                # optional, defaults to RAILWAY_ENDPOINT
RAILWAY_PUBLIC_URL_INCLUDE_BUCKET= # optional, set "false" to drop bucket from path

# autumn
AUTUMN_SECRET_KEY=

# chunkify
CHUNKIFY_PROJECT_ACCESS_TOKEN=
CHUNKIFY_WEBHOOK_SECRET=
